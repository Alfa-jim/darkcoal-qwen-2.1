{
  "title": "darkcoal-qwen-2.1",
  "description": "Experimental Qwen-Image 2.1 (7B unified T2I+edit+RGBA, up to 10 refs) - network-volume-native /runpod-volume - 40-step flow for 4090 24GB",
  "type": "serverless",
  "category": "image",
  "iconUrl": "https://cpjrphpz3t5wbwfe.public.blob.vercel-storage.com/comfy-ui.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 50,
    "gpuIds": "ADA_24",
    "gpuCount": 1,
    "allowedCudaVersions": ["12.6","12.8","12.9","13.0"],
    "env": [
      {"key": "COMFY_ORG_API_KEY", "input": {"name": "Comfy.org API Key", "type": "string", "description": "Enter your Comfy.org API key to use API Nodes", "default": "", "advanced": false}},
      {"key": "BUCKET_ENDPOINT_URL", "input": {"name": "S3 Bucket Endpoint URL", "type": "string", "description": "Upload images to S3", "default": "", "advanced": true}},
      {"key": "BUCKET_ACCESS_KEY_ID", "input": {"name": "S3 Access Key ID", "type": "string", "description": "AWS Access Key ID", "default": "", "advanced": true}},
      {"key": "BUCKET_SECRET_ACCESS_KEY", "input": {"name": "S3 Secret Access Key", "type": "string", "description": "AWS Secret Access Key", "default": "", "advanced": true}},
      {"key": "SERVE_API_LOCALLY", "input": {"name": "Serve API Locally (dev)", "type": "boolean", "description": "Dev only", "default": false, "advanced": true}},
      {"key": "COMFY_LOG_LEVEL", "input": {"name": "ComfyUI Log Level", "type": "string", "description": "DEBUG/INFO", "default": "DEBUG", "advanced": true}},
      {"key": "USE_NETWORK_VOLUME", "input": {"name": "Use Network Volume", "type": "boolean", "description": "Models on /runpod-volume (recommended)", "default": true, "advanced": false}}
    ]
  }
}
